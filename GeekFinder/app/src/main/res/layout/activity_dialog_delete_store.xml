<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtDeleteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/DialogTextTitleDelete_StoreDetail"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDeleteMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/DialogTextMessageDelete_StoreDetail"
            android:textColor="#000000"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/btnDialogDelete_StoreDetail"
            android:textColor="#000000"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCancelDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/btnDialogCancel_StoreDetail"
            android:textColor="#000000"
            android:textSize="13sp" />

    </LinearLayout>
</FrameLayout>