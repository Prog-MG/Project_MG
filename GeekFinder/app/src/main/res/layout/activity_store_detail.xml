<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StoreDetailActivity">

  <!-- General -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:id="@+id/textTitle_StoreD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/TextTitle_StoreDetail"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/img_StoreD"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="false"
        app:srcCompat="@android:drawable/ic_menu_gallery" />

    <!-- Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/textName_StoreD"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Nombre Tienda"
          android:textSize="22sp"
          android:textStyle="bold" />

      <RatingBar
          android:id="@+id/rate_StoreD"
          style="@style/Widget.AppCompat.RatingBar.Indicator"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:isIndicator="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/textHour_StoreD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/TextHours_StoreDetail"
        android:textSize="16dp" />

    <TextView
        android:id="@+id/textPhone_StoreD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/TextPhone_StoreDetail"
        android:textSize="16dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

      <Button
          android:id="@+id/btnMap_StoreD"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/btnTextViewOnMap_StoreDetail" />

      <Button
          android:id="@+id/btnEdit_StoreD"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:text="@string/btnTextEdit_StoreDetail" />

      <Button
          android:id="@+id/btnDelete_StoreD"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:text="@string/btnTextDelete_StoreDetail" />
    </LinearLayout>

    <TextView
        android:id="@+id/textReviews_StoreD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/TextReviews_StoreDetail"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Reviews -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/textCname_StoreD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre" />

        <RatingBar
            android:id="@+id/rateC_StoreD"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="true"
            android:numStars="5" />

        <TextView
            android:id="@+id/textComment_StoreD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="comentario" />

        <TextView
            android:id="@+id/textValue_StoreD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor" />
      </LinearLayout>

      <ImageView
          android:id="@+id/imgC_StoreD"
          android:layout_width="90dp"
          android:layout_height="90dp"
          app:srcCompat="@android:drawable/ic_menu_gallery" />

    </LinearLayout>

    <Button
        android:id="@+id/btnWriteReview_StoreD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/btnTextWriteReview_StoreDetail" />

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>